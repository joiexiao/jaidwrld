# .gitignore — daftar file/folder yang TIDAK di-track git.
# Isi: dependensi, hasil build, env lokal, dan binary Go (lihat bagian bawah).
# Catatan: `.env*` meng-ignore semua file .env, tapi `.env.example` DIKECUALIKAN (lihat bawah).

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# go backend (reserved)
/backend/bin/
/backend/tmp/
*.exe
